{
  "name": "orbitbit",
  "version": "0.1.2",
  "description": "An original open-source pixel astronaut desktop companion for Windows.",
  "author": "applelizihao",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "electron .",
    "dev:desktop": "node scripts/start-desktop.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:app": "vite build && electron-builder --win portable",
    "test": "node --test tests/game.test.mjs",
    "test:all": "npm run test && npm run build && npm run test:sites",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.orbitbit.desktop",
    "productName": "OrbitBit",
    "directories": { "output": "release" },
    "files": ["dist/client/**/*", "electron/**/*", "package.json"],
    "win": {
      "icon": "public/assets/orbitbit-icon.png",
      "target": ["portable"],
      "artifactName": "OrbitBit-${version}-Windows-${arch}.${ext}"
    }
  }
}
